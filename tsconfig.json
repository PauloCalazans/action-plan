{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "jest", "@cap-js/cds-types"]
  },
  "include": ["srv/**/*.ts", "test/**/*.ts", "@cds-models/**/*.ts"],
  "exclude": ["node_modules", "gen"]
}
