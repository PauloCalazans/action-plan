#!/bin/sh
# pre-commit — bloqueia commit em branch protegida e segredos no conteúdo staged. Fail-closed.
agentic_lib=""
for agentic_c in "$(dirname "$0")/../scripts/agentic/lib-agentic.sh" "$(dirname "$0")/../scripts/lib-agentic.sh"; do
  if [ -f "$agentic_c" ]; then agentic_lib=$agentic_c; break; fi
done
[ -n "$agentic_lib" ] || { echo "agentic: BLOQUEADO — lib-agentic.sh não encontrada (fail-closed)" >&2; exit 1; }
. "$agentic_lib"

branch=$(git symbolic-ref --short -q HEAD) || branch=""
if [ -n "$branch" ] && agentic_branch_protegida "$branch"; then
  agentic_falha "commit direto em '$branch' (branch protegida). Trabalhe numa branch e integre via PR."
fi

# --- Segredos: camada 1, gitleaks sobre o conteúdo staged.
command -v "$GITLEAKS_BIN" >/dev/null 2>&1 || \
  agentic_falha "gitleaks não encontrado ('$GITLEAKS_BIN'). Instale: https://github.com/gitleaks/gitleaks (fail-closed)."
"$GITLEAKS_BIN" git --pre-commit --staged --redact --no-banner --exit-code 3 "$agentic_raiz" >/dev/null 2>&1
agentic_rc=$?
if [ "$agentic_rc" -eq 3 ]; then
  agentic_falha "gitleaks encontrou segredo no conteúdo staged. Rode: $GITLEAKS_BIN git --pre-commit --staged --redact -v"
elif [ "$agentic_rc" -ne 0 ]; then
  agentic_falha "gitleaks falhou ao executar (código $agentic_rc) — fail-closed."
fi

# --- Segredos: camada 2, palavras-chave com valor literal (o gitleaks não pega senha genérica).
# Chave: contém senha|password|passwd|secret|segredo|api[_-]key|token (com prefixo/sufixo, ponto ou hífen:
# PGPASSWORD, spring.datasource.password, jwt-secret-key), seguida de ':', '=' ou ':='.
# Valor entre aspas: varrido em qualquer arquivo. Valor sem aspas: só em arquivos de configuração/shell
# (yml, yaml, properties, env, .env*, sh, bash, zsh, conf, cfg, ini, toml, mk, Makefile, Dockerfile*,
# .npmrc, .pypirc) — em código, valor sem aspas é expressão (os.environ[...], getSenha()), não literal.
# Não é segredo (placeholder): vazio; referência pura a variável ($VAR, ${VAR}, ${VAR:-}); substituição
# de comando ($(...), `...`); ${{ ... }} sem aspas internas; <...>; {{...}}; %...%; changeme, placeholder,
# example, xxx, secret sozinhos; literal com menos de 8 caracteres. Default literal embutido
# (${VAR:padrao}, ${VAR:-padrao}) é avaliado como literal. Linha com 'agentic:permitir-segredo' é isenta.
agentic_diff=$(git -c core.quotepath=off diff --cached -U0 --no-color) || \
  agentic_falha "git diff --cached falhou — não há como varrer o conteúdo staged (fail-closed)."
agentic_achados=$(printf '%s\n' "$agentic_diff" | awk -v aspa="'" '
function literal(v,   d, resto, lv) {
  if (v == "") return 0
  if (v ~ /^\$[A-Za-z_][A-Za-z0-9_.]*$/) return 0
  if (substr(v, 1, 2) == "$(" || substr(v, 1, 1) == "`") return 0
  if (substr(v, 1, 3) == "${{") {
    if (v ~ /}}$/ && index(v, "\"") == 0 && index(v, aspa) == 0) return 0
    return (length(v) >= 8)
  }
  if (substr(v, 1, 2) == "${" && substr(v, length(v), 1) == "}") {
    d = substr(v, 3, length(v) - 3)
    if (match(d, /^[A-Za-z_][A-Za-z0-9_.]*/)) {
      resto = substr(d, RLENGTH + 1)
      if (resto == "") return 0
      if (resto ~ /^:?-/) { sub(/^:?-/, "", resto); return literal(resto) }
      if (resto ~ /^:/) { sub(/^:/, "", resto); return literal(resto) }
    }
  }
  if (v ~ /^<.*>$/ || v ~ /^\{\{.*\}\}$/ || v ~ /^%.*%$/) return 0
  lv = tolower(v)
  if (lv ~ /^(changeme|placeholder|example|secret|xxx+)$/) return 0
  return (length(v) >= 8)
}
BEGIN {
  chave = "[a-z0-9_.-]*(senha|password|passwd|secret|segredo|api[_-]?key|token)[a-z0-9_.-]*[\"" aspa "]?[ \t]*(:=|[:=])[ \t]*"
  n = 0
}
/^\+\+\+ / { arq = substr($0, 5); sub(/^b\//, "", arq); next }
/^\+/ {
  linha = substr($0, 2); sub(/\r$/, "", linha)
  if (index(linha, "agentic:permitir-segredo")) next
  base = arq; sub(/.*\//, "", base); base = tolower(base)
  cfg = (base ~ /\.(yml|yaml|properties|env|sh|bash|zsh|conf|cfg|ini|toml|mk)$/ || base ~ /^\.env/ || \
         base ~ /^dockerfile/ || base == "makefile" || base == ".npmrc" || base == ".pypirc")
  resto = linha; achou = 0
  while (resto != "" && match(tolower(resto), chave)) {
    ini = RSTART + RLENGTH
    val = substr(resto, ini); c = substr(val, 1, 1); usado = 0; v = ""; avaliar = 0
    if (c == "\"" || c == aspa) {
      fim = index(substr(val, 2), c)
      if (fim == 0) { v = substr(val, 2); usado = length(val) } else { v = substr(val, 2, fim - 1); usado = fim + 1 }
      avaliar = 1
    } else if (cfg) {
      if (substr(val, 1, 3) == "${{") { fim = index(val, "}}"); v = fim ? substr(val, 1, fim + 1) : val }
      else { match(val, /^[^ \t]*/); v = substr(val, 1, RLENGTH) }
      usado = length(v); sub(/[,;]$/, "", v)
      avaliar = 1
    }
    if (avaliar && literal(v)) { achou = 1; break }
    resto = substr(resto, ini + usado)
  }
  if (achou) n++
}
END { print n }
') || agentic_falha "varredura de segredos (camada 2) falhou ao executar — fail-closed."
if [ "$agentic_achados" -gt 0 ]; then
  agentic_falha "possível segredo literal em $agentic_achados linha(s) staged. Veja 'git diff --cached'. Se for falso positivo, marque a linha com 'agentic:permitir-segredo' e justifique no PR."
fi

exit 0
