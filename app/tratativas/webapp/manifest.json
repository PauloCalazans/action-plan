{
  "_version": "2.0.0",
  "sap.app": {
    "id": "br.com.calazanstec.actionplan.tratativas",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/app/v1/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Tratativa-manage": {
          "semanticObject": "Tratativa",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://task"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.23",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {
          "lazy": false
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "br.com.calazanstec.actionplan.tratativas.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TratativasList",
          "target": "TratativasList"
        },
        {
          "pattern": "Tratativas({key}):?query:",
          "name": "TratativasObjectPage",
          "target": "TratativasObjectPage"
        }
      ],
      "targets": {
        "TratativasList": {
          "type": "Component",
          "id": "TratativasList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tratativas",
              "variantManagement": "Page",
              "navigation": {
                "Tratativas": {
                  "detail": {
                    "route": "TratativasObjectPage"
                  }
                }
              }
            }
          }
        },
        "TratativasObjectPage": {
          "type": "Component",
          "id": "TratativasObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tratativas",
              "content": {
                "body": {
                  "sections": {
                    "MetodologiaSection": {
                      "template": "br.com.calazanstec.actionplan.tratativas.ext.fragment.MetodologiaSection",
                      "title": "{i18n>metodologiaTitulo}",
                      "position": {
                        "placement": "After",
                        "anchor": "PlanoAcaoFacet"
                      }
                    }
                  }
                }
              },
              "controlConfiguration": {
                "acoes/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "criarAcao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.criarAcao",
                      "text": "{i18n>acaoCriarAcao}",
                      "requiresSelection": false,
                      "visible": "{= ${ocultaGestaoAcoes} !== true }",
                      "enabled": "{= ${podeCriarAcao} === true }"
                    },
                    "criarSubacao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.criarSubacao",
                      "text": "{i18n>acaoCriarSubacao}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelGestao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoCriarSubacao"
                    },
                    "delegarAcao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.delegarAcao",
                      "text": "{i18n>acaoDelegarAcao}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelGestao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoDelegar"
                    },
                    "anexarEvidencia": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.anexarEvidencia",
                      "text": "{i18n>acaoAnexarEvidencia}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelOperacao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoAnexar"
                    },
                    "comentarAcao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.comentarAcao",
                      "text": "{i18n>acaoComentarAcao}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelOperacao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoComentarAcao"
                    },
                    "iniciarAcao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.iniciarAcao",
                      "text": "{i18n>acaoIniciarAcao}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelOperacao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoIniciar"
                    },
                    "concluirAcao": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.concluirAcao",
                      "text": "{i18n>acaoConcluirAcao}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelOperacao",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoConcluir"
                    }
                  }
                },
                "evidencias/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "removerEvidencia": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.removerEvidencia",
                      "text": "{i18n>acaoRemoverEvidencia}",
                      "requiresSelection": true,
                      "enableOnSelect": "single",
                      "visible": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.visivelRemover",
                      "enabled": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.habilitadoRemover"
                    }
                  }
                },
                "comentarios/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "comentarTratativa": {
                      "press": "br.com.calazanstec.actionplan.tratativas.ext.acoes.OperacoesLinha.comentarTratativa",
                      "text": "{i18n>acaoComentarTratativa}",
                      "requiresSelection": false,
                      "visible": "{= ${ocultaComentarTratativa} !== true }",
                      "enabled": "{= ${podeComentarTratativa} === true }"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "br.com.calazanstec.actionplan.tratativas.ext.controller.MetodologiaExtension"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "br.com.calazanstec.actionplan"
  }
}
