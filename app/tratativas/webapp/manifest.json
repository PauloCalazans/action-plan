{
  "_version": "2.0.0",
  "sap.app": {
    "id": "br.com.calazanstec.actionplan.tratativas",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/app/v1/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Tratativa-manage": {
          "semanticObject": "Tratativa",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://task"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.23",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "br.com.calazanstec.actionplan.tratativas.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TratativasList",
          "target": "TratativasList"
        },
        {
          "pattern": "Tratativas({key}):?query:",
          "name": "TratativasObjectPage",
          "target": "TratativasObjectPage"
        }
      ],
      "targets": {
        "TratativasList": {
          "type": "Component",
          "id": "TratativasList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tratativas",
              "variantManagement": "Page",
              "navigation": {
                "Tratativas": {
                  "detail": {
                    "route": "TratativasObjectPage"
                  }
                }
              }
            }
          }
        },
        "TratativasObjectPage": {
          "type": "Component",
          "id": "TratativasObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tratativas"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "br.com.calazanstec.actionplan"
  }
}
