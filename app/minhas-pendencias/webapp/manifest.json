{
  "_version": "2.0.0",
  "sap.app": {
    "id": "br.com.calazanstec.actionplan.minhaspendencias",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/app/v1/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "MinhasPendencias-display": {
          "semanticObject": "MinhasPendencias",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://user-edit"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.23",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "br.com.calazanstec.actionplan.minhaspendencias.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MinhasPendenciasList",
          "target": "MinhasPendenciasList"
        }
      ],
      "targets": {
        "MinhasPendenciasList": {
          "type": "Component",
          "id": "MinhasPendenciasList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MinhasAcoes",
              "views": {
                "paths": [
                  {
                    "key": "MinhasAcoes",
                    "entitySet": "MinhasAcoes",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#MinhasAcoes"
                  },
                  {
                    "key": "MinhasTratativas",
                    "entitySet": "MinhasTratativas",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#MinhasTratativas"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "br.com.calazanstec.actionplan"
  }
}
