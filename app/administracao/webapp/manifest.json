{
  "_version": "2.0.0",
  "sap.app": {
    "id": "br.com.calazanstec.actionplan.administracao",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/administracao/v1/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "AdministracaoPlataforma-manage": {
          "semanticObject": "AdministracaoPlataforma",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://settings"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.23",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "br.com.calazanstec.actionplan.administracao.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AdministracaoList",
          "target": "AdministracaoList"
        },
        {
          "pattern": "Templates({key}):?query:",
          "name": "TemplatesObjectPage",
          "target": "TemplatesObjectPage"
        },
        {
          "pattern": "ParametrosAlertas(chave='{key}'):?query:",
          "name": "ParametrosAlertasObjectPage",
          "target": "ParametrosAlertasObjectPage"
        },
        {
          "pattern": "ParametrosIntegracaoSF(chave='{key}'):?query:",
          "name": "ParametrosIntegracaoSFObjectPage",
          "target": "ParametrosIntegracaoSFObjectPage"
        },
        {
          "pattern": "ParametrosOrigem(origemNormalizada='{key}'):?query:",
          "name": "ParametrosOrigemObjectPage",
          "target": "ParametrosOrigemObjectPage"
        }
      ],
      "targets": {
        "AdministracaoList": {
          "type": "Component",
          "id": "AdministracaoList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Templates",
              "navigation": {
                "Templates": {
                  "detail": {
                    "route": "TemplatesObjectPage"
                  }
                },
                "ParametrosAlertas": {
                  "detail": {
                    "route": "ParametrosAlertasObjectPage"
                  }
                },
                "ParametrosIntegracaoSF": {
                  "detail": {
                    "route": "ParametrosIntegracaoSFObjectPage"
                  }
                },
                "ParametrosOrigem": {
                  "detail": {
                    "route": "ParametrosOrigemObjectPage"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "Templates",
                    "entitySet": "Templates",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Templates"
                  },
                  {
                    "key": "ParametrosAlertas",
                    "entitySet": "ParametrosAlertas",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#ParametrosAlertas"
                  },
                  {
                    "key": "ParametrosIntegracaoSF",
                    "entitySet": "ParametrosIntegracaoSF",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#ParametrosIntegracaoSF"
                  },
                  {
                    "key": "ParametrosOrigem",
                    "entitySet": "ParametrosOrigem",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#ParametrosOrigem"
                  }
                ]
              }
            }
          }
        },
        "TemplatesObjectPage": {
          "type": "Component",
          "id": "TemplatesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Templates"
            }
          }
        },
        "ParametrosAlertasObjectPage": {
          "type": "Component",
          "id": "ParametrosAlertasObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ParametrosAlertas"
            }
          }
        },
        "ParametrosIntegracaoSFObjectPage": {
          "type": "Component",
          "id": "ParametrosIntegracaoSFObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ParametrosIntegracaoSF"
            }
          }
        },
        "ParametrosOrigemObjectPage": {
          "type": "Component",
          "id": "ParametrosOrigemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ParametrosOrigem"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "br.com.calazanstec.actionplan"
  }
}
